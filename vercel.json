{
  "outputDirectory": ".",
  "redirects": [
    {
      "source": "/ca/services/:service/:city",
      "destination": "/services/:service/:city",
      "permanent": true
    },
    {
      "source": "/ca/services/:service",
      "destination": "/services/:service",
      "permanent": true
    },
    {
      "source": "/uk/services/:service/:city",
      "destination": "/services/:service/:city",
      "permanent": true
    },
    {
      "source": "/uk/services/:service",
      "destination": "/services/:service",
      "permanent": true
    },
    {
      "source": "/au/services/:service/:city",
      "destination": "/services/:service/:city",
      "permanent": true
    },
    {
      "source": "/au/services/:service",
      "destination": "/services/:service",
      "permanent": true
    },
    {
      "source": "/ar/servicios/:service/:city",
      "destination": "/services/:service/:city",
      "permanent": true
    },
    {
      "source": "/ar/servicios/:service",
      "destination": "/services/:service",
      "permanent": true
    },
    {
      "source": "/us/services/:service/:city",
      "destination": "/services/:service/:city",
      "permanent": true
    },
    {
      "source": "/us/services/:service",
      "destination": "/services/:service",
      "permanent": true
    },
    {
      "source": "/privacy-policy",
      "destination": "/privacy",
      "permanent": true
    },
    {
      "source": "/privacy-policy.html",
      "destination": "/privacy",
      "permanent": true
    },
    {
      "source": "/for-professionals",
      "destination": "/for-pros",
      "permanent": true
    },
    {
      "source": "/pro/register",
      "destination": "/pros/signup",
      "permanent": true
    },
    {
      "source": "/pro/login",
      "destination": "/pros/login",
      "permanent": true
    },
    {
      "source": "/login/pro",
      "destination": "/pros/login",
      "permanent": true
    },
    {
      "source": "/pro/sign-in",
      "destination": "/pros/login",
      "permanent": true
    },
    {
      "source": "/pro-signin",
      "destination": "/pros/login",
      "permanent": true
    },
    {
      "source": "/pros/signin",
      "destination": "/pros/login",
      "permanent": true
    },
    {
      "source": "/signin",
      "destination": "/pros/login",
      "permanent": true
    },
    {
      "source": "/auth/login/pro",
      "destination": "/pros/login",
      "permanent": true
    },
    {
      "source": "/charlotte",
      "destination": "/request?city=charlotte-nc",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://fixloapp.onrender.com/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/social/scheduler/run",
      "schedule": "*/15 * * * *"
    }
  ],
  "headers": [
    {
      "source": "/admin/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/dashboard/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/pros/dashboard/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
